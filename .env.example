# Copiá este archivo a ".env" y completá lo que necesites.

PORT=3000

# Fuente de datos activa: local | zoho | chatbase
# - local: usa server/data/tickets.json (los datos de tu planilla). Es la
#   que funciona de entrada, sin configurar nada mas.
# - zoho: trae los datos en vivo desde Zoho (ver server/datasources/zohoDataSource.js)
# - chatbase: trae los datos en vivo desde Chatbase (ver server/datasources/chatbaseDataSource.js)
DATA_SOURCE=local

# --- Zoho (completar cuando quieras pasar a datos en vivo) ---
# Datacenter de tu cuenta Zoho: com | eu | in | com.au | jp
ZOHO_DC=com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
# (opcional) filtrar tickets de un solo departamento de Zoho Desk
ZOHO_DEPARTMENT_ID=
# (opcional) si el tópico/categoría o la complejidad viven en campos
# personalizados de Zoho Desk con otro nombre, decíselo acá sin tocar código:
ZOHO_FIELD_CATEGORY=category
ZOHO_FIELD_SUBCATEGORY=subCategory
ZOHO_FIELD_COMPLEXITY=

# --- Chatbase (completar si en el futuro también lo conectás) ---
CHATBASE_API_KEY=
CHATBASE_CHATBOT_ID=

# --- Base de datos para la auditoría (solo hace falta en Vercel) ---
# Corriendo local NO hace falta tocar esto: sin esta variable, la auditoría
# se guarda en server/data/audits.json.
# En Vercel: andá a tu proyecto → pestaña "Storage" → "Create Database" →
# elegí Postgres (hoy provisionado vía Neon) → "Connect to Project". Vercel
# inyecta automáticamente DATABASE_URL (o POSTGRES_URL, según el momento en
# que lo conectaste) en las variables de entorno del proyecto — no hace
# falta pegarla acá a mano ni en el dashboard de Vercel.
# Si querés probar la auditoría contra una base Postgres real desde tu
# compu (por ejemplo la misma de Neon), pegá acá su connection string:
DATABASE_URL=
